---
const waarden = [
  {
    title: 'Hard werken',
    text: 'Vroeg op de werf, laat naar huis als het moet. Deadlines zijn er om gehaald te worden.',
  },
  {
    title: 'Integriteit',
    text: 'Eerlijke prijzen, eerlijk advies. Wat beloofd is, wordt gedaan — ook als niemand kijkt.',
  },
  {
    title: 'Jarenlange ervaring',
    text: 'Meer dan vijftien jaar op de werf, waarvan jaren als ploegbaas. Weinig dat Brecht nog verrast.',
  },
  {
    title: 'Eén aanspreekpunt',
    text: 'U belt Brecht, en Brecht regelt het. Geen doorschuiven, geen smoesjes.',
  },
];
---

<section class="section section-dark">
  <div class="container">
    <span class="kicker">Werf 04 — Waarom Brecht</span>
    <h2>Waar u op mag rekenen</h2>
    <ul class="values">
      {
        waarden.map((waarde, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{waarde.title}</h3>
            <p>{waarde.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .section-dark {
    background: var(--ink);
    color: var(--paper);
    /* Metselwerk: vage voeglijnen in de achtergrond. */
    background-image: repeating-linear-gradient(
      0deg,
      transparent 0 62px,
      rgb(255 255 255 / 0.045) 62px 63px
    );
    border-block: 3px solid var(--accent);
  }

  .section-dark .kicker {
    color: var(--mortar);
  }

  .values {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2.5rem;
  }

  .values li {
    border-top: 2px solid var(--accent);
    padding-top: 1rem;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent);
    display: block;
    margin-bottom: 0.7rem;
  }

  .values h3 {
    color: var(--paper);
  }

  .values p {
    margin: 0;
    color: var(--mortar);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
