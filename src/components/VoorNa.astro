---
// Interactieve voor/na-vergelijker. De afbeeldingen zijn plaatshouders —
// vervang ze door echte voor- en nafoto's van eenzelfde project.
---

<div class="voorna" style="--pos: 50%">
  <img src="/images/voor.svg" alt="Kamer voor de renovatie" />
  <img
    src="/images/na.svg"
    alt="Dezelfde kamer na de renovatie"
    class="na"
    aria-hidden="true"
  />
  <div class="divider" aria-hidden="true">
    <span class="handle">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 6 2 12l6 6M16 6l6 6-6 6" />
      </svg>
    </span>
  </div>
  <span class="chip chip-voor" aria-hidden="true">Voor</span>
  <span class="chip chip-na" aria-hidden="true">Na</span>
  <input
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label="Schuif om voor en na de renovatie te vergelijken"
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('.voorna').forEach((el) => {
    const input = el.querySelector('input');
    input?.addEventListener('input', () => {
      el.style.setProperty('--pos', `${input.value}%`);
    });
  });
</script>

<style>
  .voorna {
    position: relative;
    overflow: hidden;
    border: 3px solid var(--ink);
    user-select: none;
  }

  .voorna img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .voorna .na {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--pos));
  }

  .divider {
    position: absolute;
    inset-block: 0;
    left: var(--pos);
    width: 6px;
    margin-left: -3px;
    background: repeating-linear-gradient(
      -45deg,
      var(--accent) 0 8px,
      var(--ink) 8px 16px
    );
  }

  .handle {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    width: 2.7rem;
    height: 2.7rem;
    background: var(--ink);
    color: var(--paper);
    border: 2px solid var(--paper);
    display: grid;
    place-items: center;
  }

  .chip {
    position: absolute;
    top: 0;
    padding: 0.3rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    pointer-events: none;
  }

  .chip-voor {
    left: 0;
  }

  .chip-na {
    right: 0;
    background: var(--accent);
  }

  .voorna input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }

  .voorna:has(input:focus-visible) .handle {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }
</style>
