---
import { REGION } from '../consts';
---

<section id="top" class="hero">
  <div class="container">
    <p class="sign" aria-hidden="true">
      WERF 001 — RENOVATIES &amp; VERBOUWINGEN — {REGION.toUpperCase()}
    </p>
    <h1>
      Vakmanschap<br />
      waar u op<br />
      <span class="accent">kunt bouwen.</span>
    </h1>
    <div class="hazard stripe" aria-hidden="true"></div>
    <p class="lead">
      Al meer dan vijftien jaar renoveert Brecht appartementen en woningen, van
      de eerste afbraak tot de laatste plint. Eerlijk advies, harde inzet en een
      afwerking waar hij zelf achter staat — dat is de afspraak.
    </p>
    <div class="actions">
      <a href="#contact" class="btn btn-primary">Vraag een offerte aan</a>
      <a href="#realisaties" class="btn btn-ghost">Bekijk realisaties</a>
    </div>
  </div>
  <span class="watermark" aria-hidden="true">B</span>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4rem, 10vw, 7.5rem);
    border-bottom: 3px solid var(--ink);
  }

  .sign {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--steel);
    border: 1px solid var(--mortar);
    display: inline-block;
    padding: 0.45rem 0.9rem;
    margin: 0 0 2rem;
    background: var(--bg-deep);
  }

  .hero h1 .accent {
    color: var(--accent);
  }

  .stripe {
    width: min(22rem, 60%);
    margin-block: 1.8rem 2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  .watermark {
    position: absolute;
    right: -0.06em;
    bottom: -0.28em;
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 125;
    font-weight: 900;
    font-size: clamp(16rem, 34vw, 30rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 2px var(--mortar);
    pointer-events: none;
    user-select: none;
  }
</style>
