---
import VoorNa from './VoorNa.astro';

// De afbeeldingen in /public/images zijn plaatshouders — vervang ze door
// echte werffoto's van Brecht.
const projecten = [
  {
    img: '/images/project-1.svg',
    alt: 'Illustratie van een gerenoveerde leefruimte',
    title: 'Totaalrenovatie appartement',
    place: 'Gent — leefruimte, keuken en badkamer volledig vernieuwd',
  },
  {
    img: '/images/project-2.svg',
    alt: 'Illustratie van een gerenoveerde badkamer',
    title: 'Badkamer met inloopdouche',
    place: 'Sint-Amandsberg — van gedateerd naar hedendaags in drie weken',
  },
  {
    img: '/images/project-3.svg',
    alt: 'Illustratie van een open keuken',
    title: 'Open keuken met eiland',
    place: 'Ledeberg — dragende muur vervangen, keuken en vloer vernieuwd',
  },
  {
    img: '/images/project-4.svg',
    alt: 'Illustratie van een appartementsgebouw',
    title: 'Opfrissing van zes flats',
    place: 'Gentbrugge — gefaseerd gerenoveerd terwijl het gebouw bewoond bleef',
  },
];
---

<section id="realisaties" class="section">
  <div class="container">
    <span class="kicker">Realisaties</span>
    <h2>Recent werk</h2>
    <p class="lead">
      Een greep uit de projecten die Brecht en zijn ploeg de voorbije jaren
      opleverden. Schuif zelf en zie het verschil dat vakwerk maakt.
    </p>
    <div class="voorna-wrap">
      <VoorNa />
    </div>
    <ul class="projects">
      {
        projecten.map((project) => (
          <li>
            <img src={project.img} alt={project.alt} loading="lazy" />
            <div class="caption">
              <h3>{project.title}</h3>
              <p>{project.place}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .voorna-wrap {
    margin-top: 2.5rem;
  }

  .projects {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .projects li {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .projects img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .caption {
    padding: 1.2rem 1.5rem 1.4rem;
  }

  .caption h3 {
    margin-bottom: 0.25em;
  }

  .caption p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  @media (max-width: 700px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
