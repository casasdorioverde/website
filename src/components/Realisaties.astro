---
import VoorNa from './VoorNa.astro';

// De afbeeldingen in /public/images zijn plaatshouders — vervang ze door
// echte werffoto's van Brecht.
const projecten = [
  {
    img: '/images/project-1.svg',
    alt: 'Illustratie van een gerenoveerde leefruimte',
    title: 'Totaalrenovatie appartement',
    place: 'Gent',
    detail: 'Leefruimte, keuken en badkamer volledig vernieuwd',
  },
  {
    img: '/images/project-2.svg',
    alt: 'Illustratie van een gerenoveerde badkamer',
    title: 'Badkamer met inloopdouche',
    place: 'Sint-Amandsberg',
    detail: 'Van gedateerd naar hedendaags in drie weken',
  },
  {
    img: '/images/project-3.svg',
    alt: 'Illustratie van een open keuken',
    title: 'Open keuken met eiland',
    place: 'Ledeberg',
    detail: 'Dragende muur vervangen, keuken en vloer vernieuwd',
  },
  {
    img: '/images/project-4.svg',
    alt: 'Illustratie van een appartementsgebouw',
    title: 'Opfrissing van zes flats',
    place: 'Gentbrugge',
    detail: 'Gefaseerd gerenoveerd terwijl het gebouw bewoond bleef',
  },
];
---

<section id="realisaties" class="section">
  <div class="container">
    <span class="kicker">Werf 03 — Realisaties</span>
    <h2>Recent werk</h2>
    <p class="lead">
      Een greep uit de projecten die Brecht en zijn ploeg de voorbije jaren
      opleverden. Schuif zelf en zie het verschil dat vakwerk maakt.
    </p>
    <div class="voorna-wrap">
      <VoorNa />
    </div>
    <ul class="projects">
      {
        projecten.map((project, i) => (
          <li>
            <img src={project.img} alt={project.alt} loading="lazy" />
            <div class="caption">
              <span class="tag">
                Project {String(i + 1).padStart(2, '0')} — {project.place}
              </span>
              <h3>{project.title}</h3>
              <p>{project.detail}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .voorna-wrap {
    margin-top: 3rem;
  }

  .projects {
    list-style: none;
    margin: 3px 0 0;
    padding: 3px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
    background: var(--ink);
    border: 0;
  }

  .projects li {
    background: var(--bg);
    display: grid;
  }

  .projects img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .caption {
    padding: 1.2rem 1.4rem 1.5rem;
  }

  .tag {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }

  .caption h3 {
    margin-bottom: 0.3em;
  }

  .caption p {
    margin: 0;
    color: var(--steel);
    font-size: 0.95rem;
  }

  @media (max-width: 700px) {
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
