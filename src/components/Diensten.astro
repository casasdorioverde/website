---
const diensten = [
  {
    title: 'Totaalrenovatie van appartementen',
    text: 'Van casco tot instapklaar: één plan, één planning en één verantwoordelijke voor het hele traject.',
  },
  {
    title: 'Badkamerrenovatie',
    text: 'Waterdicht, doordacht en netjes betegeld — badkamers die jaren meegaan.',
  },
  {
    title: 'Keukenrenovatie',
    text: 'Afbraak, leidingwerk, plaatsing en afwerking, afgestemd op hoe u echt kookt en leeft.',
  },
  {
    title: 'Vloer- en tegelwerk',
    text: 'Strak legwerk in elk formaat, met oog voor lijnen die kloppen tot in de hoeken.',
  },
  {
    title: 'Gyproc en binnenafwerking',
    text: 'Wanden, plafonds en plamuurwerk klaar om te schilderen — vlak is vlak.',
  },
  {
    title: 'Coördinatie van de volledige werf',
    text: 'Brecht stemt alle vakmensen op elkaar af, bewaakt timing en budget, en houdt u op de hoogte.',
  },
];
---

<section id="diensten" class="section section-deep">
  <div class="container">
    <span class="kicker">Werf 02 — Diensten</span>
    <h2>Wat Brecht voor u doet</h2>
    <p class="lead">
      Elke verbouwing is anders, maar de aanpak is altijd dezelfde: eerst goed
      luisteren, dan een duidelijk plan, en pas stoppen als alles klopt.
    </p>
    <ol class="spec">
      {
        diensten.map((dienst, i) => (
          <li>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{dienst.title}</h3>
            <p>{dienst.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .spec {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    border-top: 3px solid var(--ink);
  }

  .spec li {
    display: grid;
    grid-template-columns: 4.5rem 1fr 1.4fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.4rem 0.8rem;
    border-bottom: 1px solid var(--mortar);
    transition: background-color 0.15s ease;
  }

  .spec li:last-child {
    border-bottom: 3px solid var(--ink);
  }

  .spec li:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .spec li:hover p {
    color: var(--mortar);
  }

  .num {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
  }

  .spec h3 {
    margin: 0;
  }

  .spec p {
    margin: 0;
    color: var(--steel);
    font-size: 0.98rem;
  }

  @media (max-width: 760px) {
    .spec li {
      grid-template-columns: 3rem 1fr;
    }

    .spec p {
      grid-column: 2;
    }
  }
</style>
