---
import { SITE_NAME, TAGLINE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <span class="name">{SITE_NAME}</span>
    <span class="tagline">{TAGLINE}</span>
    <span class="copy">© {year} {SITE_NAME}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 1.6rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    align-items: baseline;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--ink);
  }

  .copy {
    margin-left: auto;
  }
</style>
