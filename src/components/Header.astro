---
import { SITE_NAME, PHONE, PHONE_HREF } from '../consts';

const links = [
  { href: '#over', label: 'Over Brecht' },
  { href: '#diensten', label: 'Diensten' },
  { href: '#realisaties', label: 'Realisaties' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="header">
  <div class="container inner">
    <a href="#top" class="logo">{SITE_NAME}</a>
    <nav aria-label="Hoofdnavigatie">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <a href={PHONE_HREF} class="phone">{PHONE}</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--ink);
    color: var(--paper);
    border-bottom: 3px solid var(--accent);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 0.85rem;
  }

  .logo {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 122;
    font-weight: 800;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--paper);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  nav {
    display: flex;
    gap: 1.6rem;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mortar);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--paper);
  }

  .phone {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--paper);
    text-decoration: none;
    background: var(--accent);
    padding: 0.5rem 1.1rem;
    white-space: nowrap;
  }

  .phone:hover {
    background: var(--accent-dark);
  }

  @media (max-width: 760px) {
    nav {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .phone {
      display: none;
    }
  }
</style>
