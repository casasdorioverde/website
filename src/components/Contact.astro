---
import { PHONE, PHONE_HREF, EMAIL, REGION } from '../consts';
---

<section id="contact" class="section section-deep">
  <div class="container grid">
    <div>
      <span class="kicker">Werf 05 — Contact</span>
      <h2>Plannen? <span class="accent">Bel Brecht.</span></h2>
      <p class="lead">
        Vertel kort wat u wilt verbouwen en Brecht komt gratis en vrijblijvend
        langs. Binnen de week hebt u een duidelijke offerte — zonder kleine
        lettertjes.
      </p>
      <a href={PHONE_HREF} class="btn btn-primary big">{PHONE}</a>
    </div>
    <ul class="details">
      <li>
        <span class="label">Telefoon</span>
        <a href={PHONE_HREF}>{PHONE}</a>
      </li>
      <li>
        <span class="label">E-mail</span>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </li>
      <li>
        <span class="label">Werkgebied</span>
        <span>{REGION}</span>
      </li>
      <li>
        <span class="label">Bereikbaar</span>
        <span>ma–za, 7u tot 19u</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .accent {
    color: var(--accent);
  }

  .big {
    font-size: 1.05rem;
    padding: 1.1rem 2.2rem;
    margin-top: 0.5rem;
  }

  .details {
    list-style: none;
    margin: 0;
    padding: 1.8rem 2rem;
    background: var(--bg);
    background-image: var(--noise);
    border: 3px solid var(--ink);
    display: grid;
    gap: 1.2rem;
  }

  .details li {
    display: grid;
    border-bottom: 1px solid var(--mortar);
    padding-bottom: 1rem;
  }

  .details li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--steel);
    margin-bottom: 0.2rem;
  }

  .details a {
    font-weight: 700;
    color: var(--ink);
    text-decoration: none;
  }

  .details a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
